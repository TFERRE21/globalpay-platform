NODE_ENV=production
PORT=3000
SITE_NAME=CrediViva
PUBLIC_BASE_URL=https://SEU-DOMINIO-AQUI
# Obrigatório para cadastro, login e acompanhamento:
# Use a variável já existente no host, se disponível, ou configure DATABASE_URL.
DATABASE_URL=
# Gere um segredo aleatório longo (mínimo 32 caracteres). Não reutilize este exemplo.
JWT_SECRET=
# Obrigatório para envio real de recuperação de senha por e-mail:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: notificações WhatsApp, apenas após configurar e aprovar a conta Meta Business.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_VERSION=v23.0
# Se seu PostgreSQL exigir SSL, use true.
POSTGRES_SSL=false
# Credenciais de provedores financeiros só devem ser adicionadas após aprovação e contrato por escrito.
# PAYMENT_PROVIDER=
# PAYMENT_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
